{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bjorn-vectors/assessor-input/v0",
  "title": "Assessor-visible input. DESIGN CANDIDATE / PROPOSED, NOT EXECUTED. Revision R1",
  "$comment": "The package checker implements only a subset of JSON Schema. A non-null segment completeness object is additionally validated by check_structure.py against $defs/completeness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "case_id", "family", "claim", "integrity_inputs", "records", "assumptions"],
  "properties": {
    "schema": {"const": "bjorn-vectors/assessor-input/v0"},
    "status": {"const": "DESIGN CANDIDATE / PROPOSED, NOT EXECUTED"},
    "case_id": {"type": "string"},
    "family": {"enum": ["B1", "B2"]},
    "claim": {"$ref": "#/$defs/claim"},
    "integrity_inputs": {"type": "object", "required": ["provenance"]},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "source_instances": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["instance_id", "epochs"]}},
    "population_evidence": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["none", "epoch_link_evidence", "independent_population_evidence"]}}},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "mediation_evidence": {"type": "array", "items": {"$ref": "#/$defs/mediation"}}
  },
  "$defs": {
    "interval": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string"}, "end": {"type": "string"}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["kind", "polarity", "scope", "cutoff"], "properties": {"kind": {"enum": ["coverage_complete", "no_bypass"]}, "polarity": {"type": "string"}, "scope": {"type": "object", "required": ["interval"], "properties": {"interval": {"$ref": "#/$defs/interval"}}}, "cutoff": {"type": "string"}}},
    "record": {"type": "object", "required": ["record_id", "seq", "time"], "properties": {"record_id": {"type": "string"}, "seq": {"type": "integer"}, "time": {"type": "string"}, "kind": {"enum": ["business", "epoch_link"]}}},
    "assumption": {"type": "object", "additionalProperties": false, "required": ["id", "text", "status"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "status": {"const": "declared_not_verified"}}},
    "completeness": {"type": "object", "additionalProperties": false, "required": ["kind", "first_seq", "last_seq", "gaps"], "properties": {"kind": {"enum": ["sequenced_feed", "sequenced_ledger"]}, "first_seq": {"type": "integer"}, "last_seq": {"type": "integer"}, "heartbeat_interval_s": {"type": "integer"}, "gaps": {"type": "array"}}},
    "segment": {"type": "object", "required": ["start", "end", "status", "completeness"], "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "status": {"enum": ["available", "available_incomplete", "unavailable"]}, "completeness": {"type": ["object", "null"]}}},
    "effect": {"type": "object", "required": ["effect_id", "time", "effect_ref"], "properties": {"effect_id": {"type": "string"}, "time": {"type": "string"}, "effect_ref": {"type": "string"}, "feed_seq": {"type": "integer"}, "route": {"type": "string"}}},
    "observation": {"type": "object", "required": ["surface", "evidence_id", "observer", "mechanism", "segments", "observed_effects", "assumptions"], "properties": {"segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}, "observed_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}}},
    "mediation": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "surface", "route_field", "mediated_routes", "statement", "assumptions"], "properties": {"evidence_id": {"type": "string"}, "surface": {"type": "string"}, "route_field": {"const": "route"}, "mediated_routes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "statement": {"type": "string"}, "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
  }
}
