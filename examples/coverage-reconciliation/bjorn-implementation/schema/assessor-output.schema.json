{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bjorn-implementation/assessor-output/v0",
  "title": "Assessor outcome. IMPLEMENTATION CANDIDATE I1 / NOT EXECUTED",
  "$comment": "Exactly one of these objects is written to stdout. Prose fields (evidence, notes) are never compared; see CONTRACT.md section 5.",
  "oneOf": [{"$ref": "#/$defs/assessed"}, {"$ref": "#/$defs/rejected"}],
  "$defs": {
    "rejected": {"type": "object", "additionalProperties": false, "required": ["schema", "result", "errors"], "properties": {"schema": {"const": "bjorn-implementation/assessor-output/v0"}, "result": {"const": "input_rejected"}, "errors": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "assessed": {"type": "object", "additionalProperties": false, "required": ["schema", "result", "case_id", "family", "integrity", "findings", "claim_results", "scoped_results", "unestablished", "notes"], "properties": {
      "schema": {"const": "bjorn-implementation/assessor-output/v0"},
      "result": {"const": "assessed"},
      "case_id": {"type": "string"},
      "family": {"enum": ["B1", "B2"]},
      "integrity": {"$ref": "#/$defs/integrity"},
      "cross_epoch": {"type": "object", "required": ["discontinuity", "from_epoch", "to_epoch", "link"]},
      "basis_assessment": {"type": "object", "required": ["kind", "status", "rules"]},
      "reconciliation": {"type": ["object", "null"]},
      "observation_assessment": {"type": "array", "items": {"type": "object", "required": ["surface", "adequate", "inadequate"]}},
      "mediation_assessment": {"type": "array", "items": {"type": "object", "required": ["surface", "status", "exhaustive", "rules"], "properties": {"status": {"enum": ["bound", "absent"]}, "exhaustive": {"type": ["boolean", "null"]}}}},
      "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
      "claim_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
      "scoped_results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
      "unestablished": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["scope", "affected_claims"], "properties": {"scope": {"type": "object", "required": ["interval"]}, "affected_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
      "notes": {"type": "array", "items": {"type": "string"}}
    }},
    "interval": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string"}, "end": {"type": "string"}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["source"], "properties": {"source": {"const": "declared_input"}, "per_epoch": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["epoch_id", "status"], "properties": {"epoch_id": {"type": "string"}, "status": {"type": "string"}}}}, "status": {"type": "string"}, "visible_log": {"enum": ["consistent", "inconsistent"]}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["type", "rules", "evidence"], "properties": {"type": {"enum": ["missing_record", "duplicate_record", "unrecorded_effect", "non_mediated_route"]}, "obligation_id": {"type": "string"}, "effect_id": {"type": "string"}, "surface": {"type": "string"}, "time": {"type": "string"}, "due": {"type": "string"}, "rules": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "string"}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["claim", "polarity", "scope", "status", "rules", "evidence", "conditional_on"], "properties": {"claim": {"enum": ["coverage_complete", "no_bypass", "bypass_occurred"]}, "polarity": {"type": "string"}, "scope": {"type": "object", "required": ["interval"]}, "status": {"enum": ["supported", "not_supported", "not_established"]}, "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"type": "string"}}, "conditional_on": {"type": "array", "items": {"type": "string"}}}}
  }
}
